# 复制为 .env 并填入真实值；仓库中不要提交任何真实密钥

# 监听地址（生产经 Cloudflare Tunnel 接入，默认只听本机）
BIND_ADDR=127.0.0.1:8787

# PostgreSQL 连接串（必填）
DATABASE_URL=postgres://user:password@127.0.0.1:5432/image_prompt_hub

# 检索索引与目录快照目录
DATA_DIR=./data

# 对外地址，用于邮件里的验证链接和 llms.txt（必填）
# 必须是 https；只有 localhost、127.0.0.1、[::1] 允许 http
PUBLIC_BASE_URL=https://hub.example.com

# 为 true 时客户端 IP 取 CF-Connecting-IP（必须是合法 IP，否则退回连接地址），否则取连接地址
# 监听地址不是回环地址时请改成 false，或确保只有 Cloudflare Tunnel 能连到服务，否则该请求头可以伪造
# 只接受 true/false/1/0/yes/no/on/off，拼写错误会拒绝启动
TRUST_CF_CONNECTING_IP=true

# 以下四项必须自己生成，留空或照抄样例无法启动。
# 三个 HMAC 密钥：至少 32 个字符、互不相同、不能包含 change-me
# 生成方法：openssl rand -base64 48
# 计算密钥哈希的 HMAC 密钥
KEY_PEPPER=

# 计算邮箱哈希的 HMAC 密钥（生成方法同上）
EMAIL_HASH_SECRET=

# 计算 IP 哈希的 HMAC 密钥（生成方法同上）
IP_HASH_SECRET=

# 32 字节 base64，加密验证记录里的邮箱明文；不能是全零字节
# 生成方法：openssl rand -base64 32
EMAIL_ENC_KEY=

# 邮箱后缀白名单；*.edu.cn 表示 edu.cn 本身及其所有子域名
EMAIL_DOMAIN_ALLOWLIST=qq.com,foxmail.com,163.com,gmail.com,*.edu.cn

# 发信方式：disabled / smtp / cloudflare
EMAIL_PROVIDER=disabled

# SMTP（与插件市场同名同义；SMTP_ENCRYPTION 的映射见 README）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=image-prompt-hub
# auto / none / starttls / ssl_tls（别名 plain、start_tls、ssl、tls）
# auto：465 端口用隐式 TLS，其余端口要求 STARTTLS（不做机会式 STARTTLS）；需要明文必须显式写 none
SMTP_ENCRYPTION=auto
# auto / login / plain / none
SMTP_AUTH_METHOD=auto
SMTP_VALIDATE_CERTS=true

# Cloudflare Email Sending（与插件市场同名同义）
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_FROM=
CLOUDFLARE_EMAIL_FROM_NAME=image-prompt-hub

# 全站每日发信上限，0 为不限；计数存数据库
EMAIL_DAILY_LIMIT=0

# 同一邮箱验证邮件冷却秒数与每日上限
EMAIL_COOLDOWN_SECS=600
EMAIL_PER_DAY_LIMIT=5

# 数据变动后多久重新生成目录快照
CATALOG_DEBOUNCE_SECS=60

# 账号写入额度（按邮箱身份计，不随密钥重置变化）
# 每小时新建模板条数（导入逐条计入，超出返回 429）
ACCOUNT_CREATE_PER_HOUR=100
# 未删除模板总数上限（超出返回 403）
ACCOUNT_TEMPLATE_LIMIT=1000

# 限流（进程内计数；IPv6 客户端按 /64 网段计）
RATE_ANON_READ_PER_MIN=60
RATE_KEYED_READ_PER_MIN=600
RATE_WRITE_PER_MIN=60
RATE_KEY_REQUEST_PER_HOUR=5
RATE_KEY_VERIFY_PER_HOUR=20
RATE_REPORT_PER_HOUR=10
# 带 Bearer 的请求在查库前按客户端 IP 扣减的认证尝试额度
RATE_AUTH_FAILURE_PER_MIN=30

# 日志格式：pretty / json
LOG_FORMAT=pretty
